{
  // The solution file. It compiles nothing itself. The root package holds three targets: the
  // browser bundle under `src/`, the Node configuration files at the root, and the Storybook
  // folder. Each workspace package under `packages/` holds one more. They need different `lib`
  // and different `types`, and a single file cannot hold them all. ADR 0001 §6 opened the
  // workspace: the schemas of a proposal are code that the browser and the writer both import.
  //
  // `baseUrl` and `paths` are repeated here because the shadcn CLI reads the root file to
  // resolve the `@/*` alias. Only `tsconfig.app.json` compiles `src/`.
  "compilerOptions": {
    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"] }
  },
  "files": [],
  "references": [
    { "path": "./tsconfig.app.json" },
    { "path": "./tsconfig.node.json" },
    { "path": "./tsconfig.storybook.json" },
    { "path": "./packages/proposal" },
    { "path": "./packages/writer" },
    { "path": "./packages/worker" }
  ]
}
