{
  // The solution file. It compiles nothing itself. Three targets now exist in one package:
  // the browser bundle under `src/`, the Node configuration files at the root, and the
  // Storybook folder, which holds one Node file and one browser file. They need different
  // `lib` and different `types`, and a single file cannot hold all three. ADR 0004 says this
  // signal is answered with a TypeScript configuration and not with a workspace, so ADR 0001
  // §6 still holds and the repository stays one package.
  //
  // `baseUrl` and `paths` are repeated here because the shadcn CLI reads the root file to
  // resolve the `@/*` alias. Only `tsconfig.app.json` compiles `src/`.
  "compilerOptions": {
    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"] }
  },
  "files": [],
  "references": [
    { "path": "./tsconfig.app.json" },
    { "path": "./tsconfig.node.json" },
    { "path": "./tsconfig.storybook.json" }
  ]
}
