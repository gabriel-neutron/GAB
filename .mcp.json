{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.83",
        "--browser",
        "chromium",
        "--headless"
      ],
      "env": {}
    },
    "gab": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${CLAUDE_PROJECT_DIR:-.}/packages/mcp/src/main.ts"
      ]
    },
    "motion": {
      "type": "http",
      "url": "https://mcp.motion.dev"
    },
    "motion-plus": {
      "type": "http",
      "url": "https://mcp.motion.dev/plus"
    }
  }
}
