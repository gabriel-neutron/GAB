{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.83",
        "--browser",
        "chromium",
        "--headless"
      ],
      "env": {}
    },
    "gab": {
      "type": "stdio",
      "command": "node",
      "args": ["packages/mcp/src/main.ts"]
    }
  }
}
