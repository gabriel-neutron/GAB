{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gab",
  "compatibility_date": "2026-10-31",
  "build": {
    "command": "pnpm run build",
  },
  "previews": {},
  // Logs on, so an abuse of the open interface shows. Keep this in step with the dashboard.
  "observability": {
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": true, "persist": true },
  },
  "main": "tools/edge/worker.ts",
  // 120 requests a minute for each address on /mcp and /api/v1/files. The files have no limit.
  "ratelimits": [
    { "name": "RATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } },
  ],
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": true,
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
}
