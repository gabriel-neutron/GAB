{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gab",
  "compatibility_date": "2026-10-31",
  "build": {
    "command": "pnpm run build",
  },
  "previews": {},
  "main": "tools/edge/worker.ts",
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": true,
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
}
