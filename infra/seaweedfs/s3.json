{
  "identities": [
    {
      "name": "gab-app",
      "credentials": [
        { "accessKey": "${RAW_STORE_ACCESS_KEY}", "secretKey": "${RAW_STORE_SECRET_KEY}" }
      ],
      "policyNames": ["gab-app-put-list"]
    },
    {
      "name": "gab-admin",
      "credentials": [
        {
          "accessKey": "${RAW_STORE_ADMIN_ACCESS_KEY}",
          "secretKey": "${RAW_STORE_ADMIN_SECRET_KEY}"
        }
      ],
      "actions": ["Read:raw", "Write:raw", "List:raw"]
    }
  ],
  "policies": [
    {
      "name": "gab-app-put-list",
      "content": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Action\":[\"s3:PutObject\"],\"Resource\":[\"arn:aws:s3:::raw/*\"]},{\"Effect\":\"Allow\",\"Action\":[\"s3:ListBucket\"],\"Resource\":[\"arn:aws:s3:::raw\"]}]}"
    }
  ]
}
