# Copy this file to infra/.env and put real values in it.
# infra/.env is excluded by .gitignore. Never commit it.

# PostgreSQL. The user and the database name are fixed in docker-compose.yml.
POSTGRES_PASSWORD=change-me

# Leave this absent: a process then reaches gabriel, the published record. `pnpm db:reset` makes
# gabriel_test beside it, and a test run refuses to start when this names any other database.
# GABRIEL_DATABASE=

# The address of the database that the tools, the writer and the worker reach. Leave all three
# absent for the local Docker stack: each then reaches 127.0.0.1:5432 with no TLS. Set all three for a remote database.
# A remote database can refuse a connection with no TLS. GABRIEL_DB_SSL is true or false.
# `pnpm db:apply` uses the psql of the host. A host with no psql uses the one in the local db
# container, and the local stack must then run.
# GABRIEL_DB_HOST=
# GABRIEL_DB_PORT=
# GABRIEL_DB_SSL=

# The account the application signs with on the S3 store. It may put an object in the bucket raw
# and list it, and nothing else. The compose file does not start without the six keys. Use only
# letters, digits, '.', '_', '+' and '-' in each key, and two different access keys.
RAW_STORE_ACCESS_KEY=
RAW_STORE_SECRET_KEY=

# The account of the tests. It may read, write and list the bucket raw. The application never
# uses it.
RAW_STORE_ADMIN_ACCESS_KEY=
RAW_STORE_ADMIN_SECRET_KEY=

# The account of the research workspace. It may put an object in the bucket raw, and nothing
# else: it may not read, list or delete. Copy these two values into research/.env as
# RAW_STORE_ACCESS_KEY and RAW_STORE_SECRET_KEY. Never give research the application keys.
RAW_STORE_RESEARCH_ACCESS_KEY=
RAW_STORE_RESEARCH_SECRET_KEY=

# The address of the S3 store and the region it signs over. Leave both absent for the local
# stack: the client then reaches 127.0.0.1:9000 and signs over us-east-1. Set both for any other
# S3 provider: its S3 endpoint and its region.
# RAW_STORE_ENDPOINT=
# RAW_STORE_REGION=

# gabriel_app calls the write functions and writes no table directly.
GABRIEL_APP_PASSWORD=
# gabriel_agent writes the candidate layer only.
GABRIEL_AGENT_PASSWORD=
# gabriel_research proposes and stores fetched documents. It cannot promote.
GABRIEL_RESEARCH_PASSWORD=
# gabriel_read reads the api schema only.
GABRIEL_READ_PASSWORD=

# The model service. The client reads the key of the endpoint that the agent names, and it throws
# when that key is empty or absent. freellmapi is the default gateway: give its base address, such
# as http://<address>:4001/v1, and its unified key. OpenRouter is the paid switch. The two
# freellmapi lines are optional: no test reads them, so a stack that calls no model can leave
# them absent.
# FREELLMAPI_BASE_URL=
# FREELLMAPI_API_KEY=
OPENROUTER_API_KEY=

# The model gateway (freellmapi). The key encrypts the provider keys that the gateway keeps in its
# volume, and the service does not start without it. Make one with `openssl rand -hex 32`. If you
# lose it, you must enter every provider key again on the Keys page.
FREELLMAPI_ENCRYPTION_KEY=

# The secret of the search service (SearXNG). It is optional. Leave it absent or empty: the
# compose file then uses a fixed value that fits a loopback port.
# SEARXNG_SECRET=
