# Copy this file to ~/gab-services/.env on the VPS. The file stays outside the checkout,
# because an agent works in the checkout and its deny rules do not hold.
# docker compose reads it through --env-file for infra/vps/services.compose.yml. It holds no
# value of the real data.

# The Tailscale IPv4 address of the VPS: the output of `tailscale ip -4`.
# Fallback with no Tailscale: 127.0.0.1, and the PC reaches the ports through an SSH tunnel.
BIND_IP=

# Pinned image tag. Never `latest`. Step 5 of the README shows how to find the current tag.
SEARXNG_TAG=2026.10.2-19ffbcd30

# The secret is made on the VPS by step 5 with `openssl rand -hex 32`. Keep it empty here.
SEARXNG_SECRET=
