# The environment of the DISPOSABLE test stack on the VPS.
# Copy this file to infra/.env on the VPS checkout (step 3 of infra/vps/README.md).
#
# Every value here is a test value, and it is public in this repository. Never put a real value
# here, and never point this file at the operator's database. The agents may reset this stack.

POSTGRES_PASSWORD=vps-test-postgres

# Leave the database address absent: the tools reach the local container at 127.0.0.1:5432.
# GABRIEL_DATABASE=
# GABRIEL_DB_HOST=
# GABRIEL_DB_PORT=
# GABRIEL_DB_SSL=

# The four accounts of the S3 store (SeaweedFS). The compose file does not start without them.
RAW_STORE_ACCESS_KEY=vps-test-raw
RAW_STORE_SECRET_KEY=vps-test-raw-secret
RAW_STORE_ADMIN_ACCESS_KEY=vps-test-raw-admin
RAW_STORE_ADMIN_SECRET_KEY=vps-test-raw-admin-secret
RAW_STORE_RESEARCH_ACCESS_KEY=vps-test-raw-research
RAW_STORE_RESEARCH_SECRET_KEY=vps-test-raw-research-secret
RAW_STORE_READ_ACCESS_KEY=vps-test-raw-read
RAW_STORE_READ_SECRET_KEY=vps-test-raw-read-secret

# Leave the store address absent: the client reaches the local container at 127.0.0.1:9000.
# RAW_STORE_ENDPOINT=
# RAW_STORE_REGION=

GABRIEL_APP_PASSWORD=vps-test-app
GABRIEL_AGENT_PASSWORD=vps-test-agent
GABRIEL_RESEARCH_PASSWORD=vps-test-research
GABRIEL_READ_PASSWORD=vps-test-read

# Empty on purpose. No test on the VPS calls a model service, so the OpenRouter key stays empty.
# A test of the model adapter uses a local server and an env argument.
OPENROUTER_API_KEY=

# A public test value for the search service of the local compose file. It keeps no real key.
SEARXNG_SECRET=vps-test-searxng-secret
