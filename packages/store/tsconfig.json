{
  // The client of the raw object store. It runs in Node beside the writer and never in a browser,
  // because it holds the credential of the store. Nothing is built: Node strips the types itself.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024"],
    "module": "preserve",
    "types": ["node"],

    "tsBuildInfoFile": "../../node_modules/.tmp/tsconfig.store.tsbuildinfo",

    // Node runs the source directly and strips the types, so an import needs the real extension.
    "allowImportingTsExtensions": true
  },
  "include": ["src"]
}
