{
  // The shape of a proposal, read by the browser bundle and by the writer. It names neither the
  // DOM nor Node, because both sides import it. Nothing is built: Node strips the types itself.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024"],
    "module": "preserve",
    "types": [],

    "tsBuildInfoFile": "../../node_modules/.tmp/tsconfig.proposal.tsbuildinfo",

    // Node runs the source directly and strips the types, so an import needs the real extension.
    "allowImportingTsExtensions": true
  },
  "include": ["src"]
}
