{
  // The MCP server of the research workspace. It reaches the database as the research role and
  // holds its credentials, and nothing under `src/` may import it. Nothing is built: Node strips
  // the types itself.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024"],
    "module": "preserve",
    "types": ["node"],

    "tsBuildInfoFile": "../../node_modules/.tmp/tsconfig.mcp.tsbuildinfo",

    // Node runs the source directly and strips the types, so an import needs the real extension.
    "allowImportingTsExtensions": true
  },
  // A test that reaches the database logs in through the helper of the schema tests, and rates an
  // author with the fixture of the schema tests, so these helpers are part of this project too.
  "include": [
    "src",
    "../../tools/probe.ts",
    "../../tools/author-fixture.ts",
    "../../tools/db-runtime.ts",
    "../../tools/test-database.ts"
  ]
}
