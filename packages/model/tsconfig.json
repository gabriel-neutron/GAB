{
  // The client of the model service. It holds the API key, and nothing under `src/` may import
  // it. Nothing is built: Node strips the types itself.
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "preserve",
    "types": ["node"],

    "composite": true,
    "noEmit": true,
    "tsBuildInfoFile": "../../node_modules/.tmp/tsconfig.model.tsbuildinfo",

    // The block below is copied in the four other targets, and the copy is deliberate. Every
    // strict check is on in every target. Change one of the five, and change all five.
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "noUncheckedSideEffectImports": true,

    // Node runs the source directly and strips the types, so an import needs the real extension.
    "allowImportingTsExtensions": true,

    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    "skipLibCheck": true
  },
  "include": ["src"]
}
