{
  // The client of the model service. It holds the API key, and nothing under `src/` may import
  // it. Nothing is built: Node strips the types itself.
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "preserve",
    "types": ["node"],

    "composite": true,
    "noEmit": true,
    "tsBuildInfoFile": "../../node_modules/.tmp/tsconfig.model.tsbuildinfo",

    // The block below is the strict set, and every compile target holds the same copy. A base
    // file with `extends` works, and it moves the standard out of the file that a reader opens.
    // Every strict check is on in every target. Change one target, and change every target.
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "noUncheckedSideEffectImports": true,

    // Node runs the source directly and strips the types, so an import needs the real extension.
    "allowImportingTsExtensions": true,

    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    "skipLibCheck": true
  },
  "include": ["src"]
}
