{
  // The Node backend. It reaches the database and holds the secret, and nothing under `src/`
  // may import it. Nothing is built: Node strips the types itself.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024"],
    "module": "preserve",
    "types": ["node"],

    "tsBuildInfoFile": "../../node_modules/.tmp/tsconfig.writer.tsbuildinfo",

    // Node runs the source directly and strips the types, so an import needs the real extension.
    "allowImportingTsExtensions": true
  },
  // A test that reaches the database logs in through the helper of the schema tests, so the
  // helper and the file it imports are part of this project too.
  "include": ["src", "../../tools/db-runtime.ts", "../../tools/test-database.ts"]
}
