ses/by/4.0/","sources":["document/eu_act"],"passages":[{"@type":"Passage","document":"document/eu_act","page":4,"excerpt":"The vessels listed in Annex XLII: SEVERNAYA VOLNA","modality":"asserts","transcribed":false}]},{"@id":"claim/0a1f0000-0000-4000-8000-000000000013","@type":"Claim","claimId":"0a1f0000-0000-4000-8000-000000000013","claimKind":"relation","about":"relation/0a1f0000-0000-4000-8000-000000000013","originLabel":"Proposed — not checked","licenceText":"derived fact; source under the provider licence, not redistributed","sources":["document/news"],"passages":[]},{"@id":"document/eu_act","@type":"Document","title":"Council Implementing Regulation (EU) 2025/0000","address":"https://eur-lex.europa.eu/eli/reg_impl/2025/0000/oj","readOn":"2026-09-30"},{"@id":"document/news","@type":"Document","title":"A tanker changes hands","address":"https://news.example.org/tanker","readOn":"2026-09-28"},{"@id":"entity/0a1f0000-0000-4000-8000-000000000005","isReplacedBy":"entity/0a1f0000-0000-4000-8000-000000000001"},{"@id":"gab:Entity","@type":"Class","label":"entity","comment":"A thing of the record: a vessel, a company, a person, a place or an act."},{"@id":"gab:Relation","@type":"Class","label":"relation","comment":"A link of one type from one entity to one entity."},{"@id":"gab:Claim","@type":"Class","label":"claim","comment":"One fact of the record: a value of an entity or of a relation, or a relation. Each claim has its sources, its origin label and its licence."},{"@id":"gab:Passage","@type":"Class","label":"passage","comment":"The part of a source document that holds the words of a claim."},{"@id":"gab:Document","@type":"Class","label":"document","comment":"A public source document of the record."},{"@id":"gab:disclaimer","@type":"Property","label":"disclaimer","comment":"The disclaimer of the dataset. Each copy of the data must keep it."},{"@id":"gab:entityType","@type":"Property","label":"entity type","comment":"The type of the entity, for example vessel or company."},{"@id":"gab:relationType","@type":"Property","label":"relation type","comment":"The type of the relation, for example owns or designated_by."},{"@id":"gab:from","@type":"Property","label":"from","comment":"The entity at the start of the relation."},{"@id":"gab:to","@type":"Property","label":"to","comment":"The entity at the end of the relation."},{"@id":"gab:claimKind","@type":"Property","label":"claim kind","comment":"attribute: the claim gives a value of an entity or of a relation. relation: the claim is the relation itself."},{"@id":"gab:attribute","@type":"Property","label":"attribute","comment":"The key of the value that the claim gives."},{"@id":"gab:value","@type":"Property","label":"value","comment":"The value that the claim gives, as JSON."},{"@id":"gab:originLabel","@type":"Property","label":"origin label","comment":"Who or what decided the row, and on which day, in fixed words. A row that no person read says so."},{"@id":"gab:licenceText","@type":"Property","label":"licence text","comment":"The licence of the row, from the providers of its public documents: CC-BY 4.0, CC-BY-NC 4.0, or \"derived fact; source under the provider licence, not redistributed\"."},{"@id":"gab:passage","@type":"Property","label":"passage","comment":"A passage of a source document that holds the claim."},{"@id":"gab:page","@type":"Property","label":"page","comment":"The page of the document that holds the passage. The first page is 1."},{"@id":"gab:excerpt","@type":"Property","label":"excerpt","comment":"The words of the passage, as the document gives them."},{"@id":"gab:modality","@type":"Property","label":"modality","comment":"How the passage holds the claim, for example asserts or enacts."},{"@id":"gab:transcribed","@type":"Property","label":"transcribed","comment":"true when an AI read the passage from an image of the page."},{"@id":"gab:readOn","@type":"Property","label":"read on","comment":"The day when the project read the document."}]}
