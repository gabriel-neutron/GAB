{
  // The build of the site of a release. Node runs the writer, which builds the application with Vite
  // and renders its pages. The fixtures of the release stay here, and the tests of the application
  // read them. Nothing is built from this folder: Node runs the source.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024"],
    "module": "preserve",
    "types": ["node"],

    "tsBuildInfoFile": "../../node_modules/.tmp/tsconfig.site.tsbuildinfo",

    // Node runs a workspace package as it stands, so an import needs the real extension.
    "allowImportingTsExtensions": true
  },
  "include": ["src"]
}
