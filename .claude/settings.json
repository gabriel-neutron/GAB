{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Write|Edit|NotebookEdit)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/product_docs_guard.py\" || python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/product_docs_guard.py\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 60,
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/session_stack_down.py\" || python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/session_stack_down.py\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "ask": [
      "mcp__gab__enqueue_extract",
      "mcp__gab__enqueue_mapping",
      "mcp__gab__start_lead",
      "mcp__gab__promote_unit",
      "mcp__gab__reject_unit",
      "mcp__gab__reject_relation",
      "mcp__gab__promote_clean_proposals"
    ]
  }
}
