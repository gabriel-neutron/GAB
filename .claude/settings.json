{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Write|Edit|NotebookEdit)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/product_docs_guard.py\" || python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/product_docs_guard.py\""
          }
        ]
      },
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/merge_base_guard.cjs\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 60,
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/session_stack_down.py\" || python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/session_stack_down.py\""
          }
        ]
      }
    ]
  },
  "model": "sonnet",
  "permissions": {
    "allow": [
      "Bash(gh pr create * --base staging *)",
      "Bash(gh pr merge * --auto --merge)",
      "Bash(gh pr merge * --merge)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr edit *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh issue comment *)",
      "Bash(gh issue create *)",
      "Bash(gh issue edit *)",
      "Bash(gh issue close *)",
      "Bash(git rebase origin/*)",
      "Bash(git push -u origin HEAD)",
      "Bash(git push origin HEAD)",
      "Bash(git push --force-with-lease origin HEAD)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git fetch *)",
      "Bash(git switch *)",
      "Bash(git worktree *)",
      "Bash(git branch -d *)",
      "Bash(git stash *)",
      "Bash(pnpm *)",
      "mcp__gab__job_status",
      "Bash(git merge *)"
    ],
    "deny": [
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push * master)",
      "Bash(gh pr merge * --admin*)",
      "Read(//**/infra/.env)",
      "Edit(//**/infra/.env)",
      "Bash(*infra*.env*)",
      "Read(//**/research/.env)",
      "Edit(//**/research/.env)",
      "Bash(*research/.env)",
      "Bash(*research/.env *)"
    ]
  },
  "enabledMcpjsonServers": [
    "playwright"
  ]
}
