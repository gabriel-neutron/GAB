{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Write|Edit|NotebookEdit)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/product_docs_guard.py\" || python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/product_docs_guard.py\""
          }
        ]
      },
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/merge_base_guard.cjs\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 60,
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/session_stack_down.py\" || python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/session_stack_down.py\""
          }
        ]
      }
    ]
  },
  "model": "sonnet",
  "permissions": {
    "allow": [
      "Bash(gh pr create * --base staging *)",
      "Bash(gh pr merge * --auto --merge)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(git rebase origin/*)",
      "Bash(git push -u origin HEAD)",
      "Bash(git push --force-with-lease origin HEAD)",
      "mcp__gab__job_status",
      "Bash(git merge *)"
    ],
    "deny": [
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push * master)",
      "Bash(gh pr merge * --admin*)"
    ]
  },
  "enabledMcpjsonServers": [
    "playwright"
  ]
}
