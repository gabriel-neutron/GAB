{
  "env": {
    "DOCS_INDEX_PATH": "docs/README.md"
  },
  "permissions": {
    "deny": [
      "Write(.claude/skills/**)",
      "Edit(.claude/skills/**)",
      "NotebookEdit(.claude/skills/**)",
      "Write(.claude/agents/**)",
      "Edit(.claude/agents/**)",
      "NotebookEdit(.claude/agents/**)",
      "Write(.claude/settings.json)",
      "Edit(.claude/settings.json)",
      "Write(.claude/hooks/**)",
      "Edit(.claude/hooks/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Write|Edit|NotebookEdit)$",
        "hooks": [
          {
            "type": "command",
            "if": "Write(docs/**)",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/docs_protection.py\""
          },
          {
            "type": "command",
            "if": "Edit(docs/**)",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/docs_protection.py\""
          },
          {
            "type": "command",
            "if": "NotebookEdit(docs/**)",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/docs_protection.py\""
          }
        ]
      }
    ]
  }
}
