{
  // The configuration files at the root. They run in Node, not in the browser.
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    // Neither file is loaded by Node directly: Vite reads `vite.config.ts` and jiti reads
    // `eslint.config.ts`, and both resolve like a bundler. `nodenext` would describe a loader
    // that never runs, and it reads a CommonJS plugin as having no default export when the
    // plugin does have one.
    "module": "preserve",
    "types": ["node"],

    "composite": true,
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "noUncheckedSideEffectImports": true,

    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    "skipLibCheck": true
  },
  "include": ["vite.config.ts", "eslint.config.ts"]
}
