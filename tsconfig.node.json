{
  // The configuration files at the root. They run in Node, not in the browser.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // DOM is here for one reason: the originator load stores a file through the ingest door of
    // the worker, and that door reads HTML with a library whose types name the DOM window.
    "lib": ["ES2024", "DOM"],
    // Neither file is loaded by Node directly: Vite reads `vite.config.ts` and jiti reads
    // `eslint.config.ts`, and both resolve like a bundler. `nodenext` would describe a loader
    // that never runs, and it reads a CommonJS plugin as having no default export when the
    // plugin does have one.
    "module": "preserve",
    "types": ["node"],

    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",

    // Node runs a command under `tools/` directly and strips the types, so an import needs the
    // real extension. Nothing emits here, so the flag costs nothing.
    "allowImportingTsExtensions": true
  },
  // `vitest.config.ts` is a root configuration file like the other two, and Vitest reads it the
  // same way Vite reads its own. `.storybook/` is **not** here; it needs the DOM library and it
  // has `tsconfig.storybook.json`.
  "include": [
    "vite.config.ts",
    "eslint.config.ts",
    "vitest.config.ts",
    "tools/**/*.ts",
    // A command loads the committed fixture, so this target reads it as well as the browser one.
    // The fixture is typed by the shapes of the record, so this target reads those too.
    "src/shared/committed-fixture/*.ts",
    // The one place a type or an attribute key is declared. A command under `tools/` writes the
    // seed file from it, and a test reads both.
    "src/shared/vocabulary/*.ts",
    // The one place a relation type is declared. It sits in a package because the door of the
    // writer reads it too, and the seed and the fixture read it from here.
    "packages/proposal/src/relation-types.ts",
    "src/shared/read/model.ts",
    // The closed sets of the base tables. A test under `tools/` compares them with the CHECKs.
    "src/shared/read/closed-set.ts",
    // The load command computes the picture through the layout door of the worker. A project
    // reference cannot carry it: a referenced project may not disable emit, and none emits.
    "packages/worker/src/layout-job.ts",
    "packages/worker/src/layout.ts"
  ]
}
