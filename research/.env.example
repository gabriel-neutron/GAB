# Copy this file to research/.env and put real values in it.
# research/.env is excluded by .gitignore. Never commit it.

# The database connection of the research sessions. The MCP server starts only as
# gabriel_research. Use the password of GABRIEL_RESEARCH_PASSWORD.
GAB_RESEARCH_DATABASE_URL=postgresql://gabriel_research:change-me@127.0.0.1:5432/gabriel

# The research account of the S3 store. It may put an object in the bucket raw, and nothing else.
# These two keys get the values of RAW_STORE_RESEARCH_ACCESS_KEY and
# RAW_STORE_RESEARCH_SECRET_KEY. Never give them the values of the application account.
RAW_STORE_ACCESS_KEY=
RAW_STORE_SECRET_KEY=

# The address of the S3 store and the region it signs over. Leave both empty for the local
# stack: the server then reaches http://127.0.0.1:9000 and signs over us-east-1. For a remote
# store, put its S3 address, for example https://s3.example.org, and its region.
RAW_STORE_ENDPOINT=
RAW_STORE_REGION=

# The SearXNG that web_search asks first.
SEARXNG_URL=http://127.0.0.1:8888

# The key of the Brave Search API, the fallback of web_search. Leave it empty to use SearXNG alone.
BRAVE_SEARCH_API_KEY=

# The key of the Companies House API, for companies_house. The register is free, and the key is
# free. Leave it empty, and companies_house refuses and names this setting; the other tools work.
COMPANIES_HOUSE_API_KEY=

# The key of the OpenSanctions API, for sanctions_match. The API needs a key. A key is free for
# journalists, academic researchers and advocacy groups, and it is paid for other use. The tool
# sends it in a header and never in an address. Leave it empty, and sanctions_match refuses and
# names this setting; the other tools work.
OPENSANCTIONS_API_KEY=

# The token of the Global Fishing Watch API, for vessel_events. The API is free: register an
# account on its site and request a token. Leave it empty, and vessel_events refuses and names
# this setting; the other tools work.
GFW_API_TOKEN=

# The folder where the browser of the session saves a page for store_saved_file. Put the download
# folder of the browser here, or leave it empty: the folder research/inbox is then used.
GAB_INBOX=
