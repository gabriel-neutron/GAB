{
  "name": "gab",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": "^24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node tools/bundle-guard.ts",
    "preview": "vite preview",
    "typecheck": "tsr generate && tsc -b",
    "lint": "eslint . --config eslint.config.ts --no-config-lookup --max-warnings=0 --cache --cache-location node_modules/.cache/eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check . --cache",
    "check": "pnpm run db:drift && pnpm run typecheck && pnpm run lint && pnpm run format:check",
    "census": "node tools/comment-report.ts",
    "db:migrate": "node --env-file=infra/.env tools/db-migrate.ts",
    "db:apply": "node --env-file=infra/.env tools/db-apply.ts",
    "db:reset": "node --env-file=infra/.env tools/db-reset.ts",
    "db:load-fixture": "node --env-file=infra/.env tools/db-load-fixture.ts",
    "db:types": "node --env-file=infra/.env tools/db-types.ts",
    "db:drift": "node --env-file=infra/.env tools/db-drift.ts",
    "test": "vitest run",
    "test:writer": "node --env-file=infra/.env node_modules/vitest/vitest.mjs run --project writer",
    "test:contract": "node --env-file=infra/.env node_modules/vitest/vitest.mjs run --project contract",
    "test:schema": "node --env-file=infra/.env node_modules/vitest/vitest.mjs run --project schema",
    "test:perimeter": "node --env-file=infra/.env node_modules/vitest/vitest.mjs run --project perimeter",
    "test:corpus": "node --env-file=infra/.env node_modules/vitest/vitest.mjs run --project corpus",
    "test:service": "node --env-file=infra/.env node_modules/vitest/vitest.mjs run --project service",
    "writer": "node --env-file=infra/.env packages/writer/src/main.ts",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@storybook/addon-vitest": "^10.5.7",
    "@storybook/react-vite": "^10.5.7",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-cli": "^1.167.27",
    "@tanstack/router-plugin": "^1.168.29",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "jiti": "^2.6.1",
    "kanel": "^4.0.3",
    "kanel-zod": "^4.0.1",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.0",
    "playwright": "^1.62.1",
    "prettier": "^3.6.2",
    "storybook": "^10.5.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@gab/proposal": "workspace:*",
    "@tanstack/react-router": "^1.170.25",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "graphology": "^0.26.0",
    "lucide-react": "^1.30.0",
    "maplibre-gl": "^6.2.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.16.2",
    "sigma": "^3.0.3",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  }
}
