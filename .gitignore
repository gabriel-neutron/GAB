# Local Claude Code settings — contains GH_TOKEN, never commit
.claude/settings.local.json

# Environment
.env
.env.*
!.env.example

# Scratch
.scratch/

# Local files that must never enter the repository
.private/

# The v1 source record. This repository is public, and the file holds the gazetteer and the
# notes of the analyst. It is the input to the corpus load and it is never an artefact of it.
*.gpkg

# Local database backups. The repository is public, and a backup carries the same corpus a
# .gpkg does. Never commit one.
infra/backups/

# Python bytecode (the docs hook runs under python)
__pycache__/
*.py[cod]

# OS
Thumbs.db
desktop.ini
.DS_Store

# Editors
.vscode/
.idea/
*.swp

# Node (nothing yet — T1 locks TypeScript, so this lands early)
node_modules/
dist/
build/
storybook-static/
coverage/
*.tsbuildinfo
npm-debug.log*

# Tests

.playwright-mcp/

# The report that a run of pnpm worker ingest writes where it starts
ingest-report.json

# The notes, the list of needs and the files that a browser saved for a research session. They
# stay on the machine of the operator.
research/out/
research/inbox/
